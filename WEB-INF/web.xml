<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1"
         metadata-complete="true">

    <display-name>Tour Management - JSP Servlet MVC</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Global Common Data Filter -->
    <filter>
        <filter-name>CommonDataFilter</filter-name>
        <filter-class>com.tour.filter.CommonDataFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CommonDataFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Servlets -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.tour.controller.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TourDetailServlet</servlet-name>
        <servlet-class>com.tour.controller.TourDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TourDetailServlet</servlet-name>
        <url-pattern>/tour/detail/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CategoryServlet</servlet-name>
        <servlet-class>com.tour.controller.CategoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CategoryServlet</servlet-name>
        <url-pattern>/category/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SearchServlet</servlet-name>
        <servlet-class>com.tour.controller.SearchServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SearchServlet</servlet-name>
        <url-pattern>/search</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CartServlet</servlet-name>
        <servlet-class>com.tour.controller.CartServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CartServlet</servlet-name>
        <url-pattern>/cart</url-pattern>
        <url-pattern>/cart/detail</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>OrderServlet</servlet-name>
        <servlet-class>com.tour.controller.OrderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OrderServlet</servlet-name>
        <url-pattern>/order/create</url-pattern>
        <url-pattern>/order/success</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ContactServlet</servlet-name>
        <servlet-class>com.tour.controller.ContactServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ContactServlet</servlet-name>
        <url-pattern>/contact/create</url-pattern>
    </servlet-mapping>

    <!-- Admin Servlets -->
    <servlet>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <servlet-class>com.tour.controller.admin.AdminDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <url-pattern>/admin</url-pattern>
        <url-pattern>/admin/dashboard</url-pattern>
        <url-pattern>/admin/dashboard/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminTourServlet</servlet-name>
        <servlet-class>com.tour.controller.admin.AdminTourServlet</servlet-class>
        <multipart-config>
            <max-file-size>20971520</max-file-size>
            <max-request-size>41943040</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminTourServlet</servlet-name>
        <url-pattern>/admin/tour/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminCategoryServlet</servlet-name>
        <servlet-class>com.tour.controller.admin.AdminCategoryServlet</servlet-class>
        <multipart-config>
            <max-file-size>20971520</max-file-size>
            <max-request-size>41943040</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminCategoryServlet</servlet-name>
        <url-pattern>/admin/category/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminOrderServlet</servlet-name>
        <servlet-class>com.tour.controller.admin.AdminOrderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminOrderServlet</servlet-name>
        <url-pattern>/admin/order/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminContactServlet</servlet-name>
        <servlet-class>com.tour.controller.admin.AdminContactServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminContactServlet</servlet-name>
        <url-pattern>/admin/contact/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminSettingServlet</servlet-name>
        <servlet-class>com.tour.controller.admin.AdminSettingServlet</servlet-class>
        <multipart-config>
            <max-file-size>20971520</max-file-size>
            <max-request-size>41943040</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminSettingServlet</servlet-name>
        <url-pattern>/admin/setting/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminUserServlet</servlet-name>
        <servlet-class>com.tour.controller.admin.AdminUserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminUserServlet</servlet-name>
        <url-pattern>/admin/user/*</url-pattern>
        <url-pattern>/admin/customer/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminProfileServlet</servlet-name>
        <servlet-class>com.tour.controller.admin.AdminProfileServlet</servlet-class>
        <multipart-config>
            <max-file-size>20971520</max-file-size>
            <max-request-size>41943040</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminProfileServlet</servlet-name>
        <url-pattern>/admin/profile/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminAccountServlet</servlet-name>
        <servlet-class>com.tour.controller.admin.AdminAccountServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminAccountServlet</servlet-name>
        <url-pattern>/admin/login</url-pattern>
        <url-pattern>/admin/account/*</url-pattern>
    </servlet-mapping>

</web-app>
