                                            src="/assets/images/Product-1.jpg"
                                            )
                                    .inner-item-content
                                        .inner-item-title Nhật Bản
                                        .inner-item-desc 50 tours
                    .inner-box.inner-user
                        .inner-input-group
                            img.inner-icon(
                                alt="" 
                                src="/assets/images/User.svg"
                                )
                            input.inner-input(
                                readonly="" 
                                placeholder="Số lượng" 
                                type="text"
                                )
                            i.fa-solid.fa-angle-down.inner-down
                        .inner-quantity
                            .inner-item
                                .inner-label Người lớn
                                .inner-count
                                    span.inner-down -
                                    span.inner-number(stock-adult) 0
                                    span.inner-up +
                            .inner-item
                                .inner-label Trẻ em
                                .inner-count
                                    span.inner-down -
                                    span.inner-number(stock-children) 0
                                    span.inner-up +
                            .inner-item
                                .inner-label Em bé
                                .inner-count
                                    span.inner-down -
                                    span.inner-number(stock-baby) 0
                                    span.inner-up +
                    .inner-box.inner-calendar
                        .inner-input-group
                            img.inner-icon(
                                alt="" 
                                src="/assets/images/Calendar.svg"
                                )
                            input.inner-input(
                                placeholder="Lịch Khởi Hành" 
                                type="date"
                                name="departureDate"
                                )
                    button.inner-button
