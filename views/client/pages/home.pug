                            .inner-label Ngày
                        .inner-item
                            .inner-time 12
                            .inner-label Giờ
                        .inner-item
                            .inner-time 20
                            .inner-label Phút
                        .inner-item
                            .inner-time 30
                            .inner-label Giây
                    .inner-discount-title GIẢM ĐẾN
                    .inner-discount-price
                        | 990.000
                        span.unit đ
                .inner-list
                    .swiper.swiper-section-2
                        .swiper-wrapper
                            each item in tourListSection2
                                .swiper-slide
                                    +product-item(item)
                        
