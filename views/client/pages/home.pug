extends ../layouts/default.pug
include ../mixins/product-item.pug

block main
    .section-1
        .container
            .inner-wrap
                h1.inner-title(
                    data-aos-duration="800" 
                    data-aos="fade-up"
                    )
                    | Du lịch Châu Á - Khám phá Mỹ, Úc, Âu
                    br
                    | Đi nơi đâu bạn muốn
                p.inner-desc(
                    data-aos-delay="150" 
                    data-aos-duration="800" 
                    data-aos="fade-up"
                    )
                    | Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua
                form.inner-form(
                    data-aos-delay="300" 
                    data-aos-duration="800" 
                    data-aos="fade-up" 
                    action=""
                    form-search
                    )
                    .inner-box.inner-location
                        .inner-input-group
                            img.inner-icon(
                                alt="" 
                                src="/assets/images/Location.svg"
                                )
                            input.inner-input(
                                placeholder="Bạn muốn đi đâu" 
                                type="text"
                                name="locationTo"
                                )
                            i.fa-solid.fa-angle-down.inner-down
                        .inner-suggest
                            .inner-suggest-title
                                i.fa-solid.fa-location-dot
                                | Địa Điểm Hot
                            .inner-suggest-list
                                .inner-item
                                    .inner-item-image
                                        img(
                                            alt="Product-1" 
                                            src="/assets/images/Product-1.jpg"
                                            )
                                    .inner-item-content
                                        .inner-item-title Nhật Bản
                                        .inner-item-desc 50 tours
                                .inner-item
                                    .inner-item-image
                                        img(
                                            alt="Product-1" 
                                            src="/assets/images/Product-1.jpg"
