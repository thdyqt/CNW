extends ../layouts/default.pug

block main
    .section-11
        .container
            .inner-wrap
                .inner-head
                    .inner-title Giỏ Hàng
                    a.inner-back(href="#")
                        | Quay lại mua hàng
                        i.fa-solid.fa-angle-right
                .inner-tour-list
                    .inner-tour-item
                        .inner-actions
                            button.inner-delete
                                i.fa-solid.fa-xmark
                            input.inner-check(type="checkbox")
                        .inner-product
                            .inner-image
                                a(href="#")
                                    img(
                                        alt="Background-15" 
                                        src="assets/images/Background-15.jpg"
                                        )
                            .inner-content
                                .inner-title
                                    a(href="#") Tour Châu Âu Đón Noel | 11N10D | Pháp – Thụy Sĩ – Ý
                                .inner-meta
                                    .inner-meta-item
                                        | Mã Tour: 
                                        b 123456789
                                    .inner-meta-item
                                        | Ngày Khởi Hành: 
                                        b 29/07/2006
                                    .inner-meta-item
                                        | Khởi Hành Tại: 
                                        b Hà Nội
                        .inner-quantity
                            .inner-label Số Lượng Hành Khách
                            .inner-list
                                .inner-item
                                    label.inner-item-label(for="adult-count") Người lớn:
                                    .inner-item-input
                                        input#adult-count(
                                            min="0" 
                                            value="1" 
                                            name="adult-count" 
                                            type="number"
                                            )
                                    .inner-price
                                        span 1 
                                        span x 
                                        span.inner-highlight 10.000.000
                                .inner-item
                                    label.inner-item-label(for="kid-count") Trẻ em:
                                    .inner-item-input
                                        input#kid-count(
                                            min="0" 
                                            value="0" 
                                            name="kid-count" 
                                            type="number"
                                            )
                                    .inner-price
                                        span 1 
                                        span x 
                                        span.inner-highlight 7.900.000
                                .inner-item
                                    label.inner-item-label(for="baby-count") Em bé:
                                    .inner-item-input
                                        input#baby-count(
                                            min="0" 
                                            value="0" 
                                            name="baby-count" 
                                            type="number"
                                            )
                                    .inner-price
                                        span 1 
                                        span x 
                                        span.inner-highlight 5.900.000
                    .inner-tour-item
                        .inner-actions
                            button.inner-delete
                                i.fa-solid.fa-xmark
                            input.inner-check(type="checkbox")
                        .inner-product
                            .inner-image
                                a(href="#")
                                    img(
                                        alt="Background-15" 
                                        src="assets/images/Background-15.jpg"
                                        )
                            .inner-content
                                .inner-title
                                    a(href="#") Tour Châu Âu Đón Noel | 11N10D | Pháp – Thụy Sĩ – Ý
                                .inner-meta
                                    .inner-meta-item
                                        | Mã Tour:
                                        b 123456789
                                    .inner-meta-item
                                        | Ngày Khởi Hành:
                                        b 29/07/2006
                                    .inner-meta-item
                                        | Khởi Hành Tại:
                                        b Hà Nội
                        .inner-quantity
                            .inner-label Số Lượng Hành Khách
                            .inner-list
                                .inner-item
                                    label.inner-item-label(for="adult-count") Người lớn:
                                    .inner-item-input
                                        input#adult-count(
                                            min="0" 
                                            value="1" 
                                            name="adult-count" 
                                            type="number"
                                            )
                                    .inner-price
                                        span 1
                                        span x
                                        span.inner-highlight 10.000.000
                                .inner-item
                                    label.inner-item-label(for="kid-count") Trẻ em:
                                    .inner-item-input
                                        input#kid-count(
                                            min="0" 
                                            value="0" 
                                            name="kid-count" 
                                            type="number"
                                            )
                                    .inner-price
                                        span 1
                                        span x
                                        span.inner-highlight 7.900.000
                                .inner-item
                                    label.inner-item-label(for="baby-count") Em bé:
                                    .inner-item-input
                                        input#baby-count(
                                            min="0" 
                                            value="0" 
                                            name="baby-count" 
                                            type="number"
                                            )
                                    .inner-price
                                        span 1
                                        span x
                                        span.inner-highlight 5.900.000
                .inner-coupon
                    form#coupon-form(action="")
                        input#coupon-input(
                            placeholder="Nhập mã giảm giá" 
                            name="coupon" 
                            type="text"
                            )
                        button Dùng Mã
                .inner-list-price
                    .inner-item
                        .inner-label Tổng tiền:
                        .inner-price 15.070.000 đ
                    .inner-item
                        .inner-label Giảm:
                        .inner-price -5.070.000 đ
                    .inner-item
                        .inner-label Thanh toán:
                        .inner-total-price 10.000.000 đ
        .section-12
            .container
                .inner-wrap
                    form#order-form(action="")
                        .inner-info
                            .inner-title-main Thông Tin Khách Hàng
                            .inner-inputs
                                .inner-input
                                    input#full-name-input(
                                        placeholder="Họ và tên" 
                                        name="fullName" 
                                        type="text"
                                        )
                                .inner-input
                                    input#phone-input(
                                        placeholder="Số điện thoại" 
                                        name="phone" 
                                        type="number"
                                        )
                            textarea(
                                placeholder="Ghi chú" 
                                name="note"
                                )
                        .inner-method
                            .inner-title-main Chọn phương thức thanh toán
                            .inner-list
                                .inner-item
                                    input#methodMoney(
                                        value="money" 
                                        name="method" 
                                        type="radio"
                                        )
                                    label(for="methodMoney") Thanh toán tiền mặt khi đi tour
                                .inner-item
                                    input#methodMomo(
                                        value="momo" 
                                        name="method" 
                                        type="radio"
                                        )
                                    label(for="methodMomo") Ví MoMo
                                .inner-item
                                    input#methodBank(
                                        value="bank" 
                                        name="method" 
                                        type="radio"
                                        )
                                    label(for="methodBank") Chuyển khoản ngân hàng
                            .inner-info-bank
                                .inner-title Thông tin chuyển khoản
                                .inner-content
                                    .inner-text Ngân hàng : Vietcombank
                                    .inner-text Tên tài khoản: Le Van A
                                    .inner-text STK: 0123456789
                        .inner-button
                            button(type="submit") ĐẶT TOUR