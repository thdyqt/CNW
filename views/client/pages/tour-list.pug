extends ../layouts/default.pug
include ../mixins/box-breadcrumb.pug
include ../mixins/product-item.pug

block main    
    +box-breadcrumb(breadcrumb)

    .section-9
        .container
            .inner-wrap
                .inner-left
                    .box-filter
                        .inner-head
                            .inner-title Bộ Lọc
                            i.fa-solid.fa-filter
                        .inner-body
                            .inner-group
                                label.inner-label(for="locationFrom") Điểm đi
                                select#locationFrom(name="locationFrom")
                                    option(value="") -- Chọn điểm đi --
                                    each item in cityList
                                        option(value=item.id) #{item.name}
                            .inner-group
                                label.inner-label(for="locationTo") Điểm đến
                                select#locationTo(name="locationTo")
                                    option(value="") -- Chọn điểm đến --
                                    each item in cityList
                                        option(value=item.name) #{item.name}
                            .inner-group
                                label.inner-label(for="departureDate") Ngày khởi hành
                                input#departureDate(
                                    name="departureDate" 
                                    type="date"
                                    )
                            .inner-group
                                label.inner-label(for="stock") Số Lượng Hành Khách
                                .inner-input-list
                                    .inner-input-item
                                        span Người lớn:
                                        input#stock(
                                            value="0" 
                                            name="stockAdult" 
                                            type="number"
                                            )
                                    .inner-input-item
                                        span Trẻ em:
                                        input(
                                            value="0" 
                                            name="stockChildren" 
                                            type="number"
                                            )
                                    .inner-input-item
                                        span Em bé:
                                        input(
                                            value="0" 
                                            name="stockBaby" 
                                            type="number"
                                            )
                            .inner-group
                                label.inner-label(for="price") Mức giá
                                select#price(name="price")
                                    option(value="") -- Chọn khoảng giá --
                                    option(value="0-999999") Dưới 1 triệu
                                    option(value="1000000-3000000") 1 triệu đến 3 triệu
                                    option(value="3000000-6000000") 3 triệu đến 6 triệu
                                    option(value="6000000-10000000") 6 triệu đến 10 triệu
                                    option(value="10000000-10000000000") Trên 10 triệu
                            .inner-group
                                button.inner-button Áp Dụng
                    .inner-overlay
                .inner-right
                    .inner-info
                        h2.inner-title #{category.name}
                        .inner-desc
                            | !{category.description}
                    .inner-info-2
                        .inner-sort
                            .inner-label Sắp xếp:
                            .inner-list
                                button
                                    | Giá tăng dần
                                    i.fa-solid.fa-square-caret-up
                                button
                                    | Giá giảm dần
                                    i.fa-solid.fa-square-caret-down
                                button.active
                                    | Khuyến Mãi Hot
                                    i.fa-solid.fa-tag
                                button
                                    | Xem Nhiều
                                    i.fa-solid.fa-eye
                        .inner-count-record
                            | Tất cả:
                            b 
                            | #{tourListSection9.length} Tour
                        button.inner-filter-mobile
                            span.inner-title Bộ Lọc
                            i.fa-solid.fa-filter
                    .inner-list-tour
                        each item in tourListSection9
                            +product-item(item)
                    .box-pagination
                        button
                            i.fa-solid.fa-angles-left
                        button.active 1
                        button 2
                        button 3
                        button 4
                        button
                            i.fa-solid.fa-angles-right