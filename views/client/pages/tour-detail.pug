extends ../layouts/default.pug
include ../mixins/box-breadcrumb.pug

block main
    +box-breadcrumb(breadcrumb)

    .section-10
        .container
            .inner-wrap
                .inner-left
                    .box-images
                        .inner-image-main
                            .swiper.swiper-box-image-main
                                .swiper-wrapper
                                    each image in tourDetail.images
                                        .swiper-slide
                                            .inner-image
                                                img(alt="" src=image)
                        .inner-image-thumb
                            .swiper.swiper-box-image-thumb
                                .swiper-wrapper
                                    each image in tourDetail.images
                                        .swiper-slide
                                            .inner-image
                                                img(alt="" src=image)
                                    
                    .box-tour-info
                        .inner-title Thông Tin Tour
                        .inner-content !{tourDetail.information}
                        .inner-read-more
                            button.button-outline Xem tất cả
                    .box-tour-schedule
                        .inner-title-main Lịch Trình Tour
                        .inner-list
                            each item in tourDetail.schedules
                                .inner-item
                                    .inner-title #{item.title}
                                    .inner-content !{item.description}                    
                .inner-right
                    .box-tour-detail
                        .inner-title-main Chuyến Đi Của Bạn
                        .inner-product
                            .inner-image
                                img(
                                    alt=tourDetail.name 
                                    src=tourDetail.avatar
                                    )
                            .inner-info
                                .inner-title #{tourDetail.name}
                                .inner-rating
                                    .inner-stars
                                        i.fa-solid.fa-star
                                        i.fa-solid.fa-star
                                        i.fa-solid.fa-star
                                        i.fa-solid.fa-star
                                        i.fa-solid.fa-star
                                    .inner-number 500 lượt đánh giá
                        .inner-meta
                            .inner-item
                                i.fa-solid.fa-ticket-simple
                                span Mã Tour: 
                                span.inner-highlight 28T00001
                            .inner-item
                                i.fa-solid.fa-calendar-days
                                span Thời Gian: 
                                span.inner-highlight #{tourDetail.time}
                            .inner-item
                                i.fa-solid.fa-car
                                span Phương Tiện: 
                                span.inner-highlight #{tourDetail.vehicle}
                            .inner-item
                                i.fa-solid.fa-calendar-days
                                span Ngày Khởi Hành: 
                                span.inner-highlight #{tourDetail.departureDateFormatted}
                        div.inner-form(action="")
                            .inner-group
                                label.inner-label(for="location-from") Khởi Hành Tại:
                                select#location-from(location-from)
                                    each item in cityList
                                        option(value=item.id) #{item.name}
                            .inner-group
                                label.inner-label(for="count") Số Lượng Hành Khách:
                                .inner-list
                                    .inner-item
                                        label.inner-item-label(for="stockAdult") Người lớn:
                                        .inner-item-input
                                            input#stockAdult(
                                                min="0"
                                                max=tourDetail.stockAdult 
                                                value="1" 
                                                name="stockAdult" 
                                                type="number"
                                                input-stock-adult
                                                price=tourDetail.priceNewAdult
                                                )
                                        .inner-price
                                            span(stock-adult) 1 
                                            span x 
                                            span.inner-highlight #{tourDetail.priceNewAdult.toLocaleString("vi-VN")}
                                    .inner-item
                                        label.inner-item-label(for="stockChildren") Trẻ em:
                                        .inner-item-input
                                            input#stockChildren(
                                                min="0"
                                                max=tourDetail.stockChildren  
                                                value="0" 
                                                name="stockChildren" 
                                                type="number"
                                                input-stock-children
                                                price=tourDetail.priceNewChildren
                                                )
                                        .inner-price
                                            span(stock-children) 0 
                                            span x 
                                            span.inner-highlight #{tourDetail.priceNewChildren.toLocaleString("vi-VN")}
                                    .inner-item
                                        label.inner-item-label(for="stockBaby") Em bé:
                                        .inner-item-input
                                            input#stockBaby(
                                                min="0"
                                                max=tourDetail.stockBaby 
                                                value="0" 
                                                name="stockBaby" 
                                                type="number"
                                                input-stock-baby
                                                price=tourDetail.priceNewBaby
                                                )
                                        .inner-price
                                            span(stock-baby) 0 
                                            span x 
                                            span.inner-highlight #{tourDetail.priceNewBaby.toLocaleString("vi-VN")}
                            .inner-total
                                .inner-total-label Tổng cộng
                                .inner-total-price(total-price) #{tourDetail.priceNewAdult.toLocaleString("vi-VN")}đ 
                            button.inner-button-add-cart(tour-id=tourDetail.id) Thêm Vào Giỏ Hàng