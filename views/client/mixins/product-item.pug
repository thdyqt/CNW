mixin product-item(item)
    .product-item
        .inner-image
            a(href="#")
                img(
                    alt=item.name
                    src=item.avatar
                    )
        .inner-discount
            i.fa-solid.fa-bolt
            .inner-discount-percent GIẢM -#{item.discount}%
        .inner-content
            h3.inner-title
                a(href=item.slug) #{item.name}
            .inner-prices
                if (item.discount > 0)
                    .inner-old-price
                        | #{item.priceOld.toLocaleString("vi-VN")}
                        span.unit đ
                .inner-new-price
                    | #{item.priceNew.toLocaleString("vi-VN")}
                    span.unit đ
            .inner-desc
                .inner-desc-item
                    | Mã Tour: 
                    b #{item.code}
                .inner-desc-item
                    | Ngày Khởi Hành: 
                    b #{item.departureDate}
                .inner-desc-item
                    | Thời Gian: 
                    b #{item.time}
            .inner-meta
                .inner-rating
                    .inner-stars
                        - for (let i = 1; i <= item.ratingStars; i++)
                            i.fa-solid.fa-star
                        - for (let j = item.ratingStars + 1; j <= 5; j++)
                            i.fa-regular.fa-star
                    .inner-number (#{item.ratingTotal})
                .inner-stock
                    .inner-label Số chỗ còn:
                    .inner-number #{item.stock}