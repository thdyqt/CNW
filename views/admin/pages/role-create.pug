extends ../layouts/default.pug


block main
    h1.box-title Tạo nhóm quyền

    .section-8
        form#role-create-form
            .inner-group
                label.inner-label(for="name") Tên nhóm quyền
                input(type="text", id="name", name="name")
            .inner-group
                label.inner-label(for="desc") Mô tả ngắn
                input(type="text", id="desc", name="desc")
            .inner-group
                label.inner-label Phân quyền
                    .inner-checkbox-list
                        .inner-checkbox-item
                            input(type="checkbox", id="1", name="permissions")
                            label(for="1") Xem trang Tổng quan
                        .inner-checkbox-item
                            input(type="checkbox", id="2", name="permissions")
                            label(for="2") Xem danh mục
                        .inner-checkbox-item
                            input(type="checkbox", id="3", name="permissions")
                            label(for="3") Tạo danh mục
                        .inner-checkbox-item
                            input(type="checkbox", id="4", name="permissions")
                            label(for="4") Sửa danh mục
                        .inner-checkbox-item
                            input(type="checkbox", id="5", name="permissions")
                            label(for="5") Xóa danh mục
            .inner-button.inner-two-col
                button Tạo mới
        .inner-back
            a(href=`/${pathAdmin}/setting/role/list`) Quay lại danh sách