extends ../layouts/default.pug


block main
    h1.box-title Tạo nhóm quyền

    .section-8
        form#role-create-form
            .inner-group
                label.inner-label(for="name") Tên nhóm quyền
                input(type="text", id="name", name="name")
            .inner-group
                label.inner-label(for="description") Mô tả ngắn
                input(type="text", id="description", name="description")
            .inner-group
                label.inner-label Phân quyền
                    .inner-checkbox-list
                        each item in permissionList
                            .inner-checkbox-item
                                input(type="checkbox", id=item.value, name="permissions" value=item.value)
                                label(for=item.value) #{item.label}
                        
            .inner-button.inner-two-col
                button Tạo mới
        .inner-back
            a(href=`/${pathAdmin}/setting/role/list`) Quay lại danh sách