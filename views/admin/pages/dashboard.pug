extends ../layouts/default.pug

block main
    if(account.permissions.includes("dashboard-view"))
        h1.box-title Tổng quan

        //- Section-1
        .section-1
            .inner-item
                .inner-icon
                    img(src="/admin/assets/images/Icon-1.svg")
                .inner-content
                    .inner-title Tài khoản người dùng
                    .inner-number #{overview.totalUser.toLocaleString("vi-VN")}
            .inner-item
                .inner-icon
                    img(src="/admin/assets/images/Icon-1.svg")
                .inner-content
                    .inner-title Tài khoản quản trị
                    .inner-number #{overview.totalAdmin.toLocaleString("vi-VN")}
            .inner-item
                .inner-icon
                    img(src="/admin/assets/images/Icon-2.svg")
                .inner-content
                    .inner-title Đơn hàng tháng này
                    .inner-number #{overview.totalOrder.toLocaleString("vi-VN")}
            .inner-item
                .inner-icon
                    img(src="/admin/assets/images/Icon-3.svg")
                .inner-content
                    .inner-title Doanh thu tháng này
                    .inner-number #{overview.totalRevenue.toLocaleString("vi-VN")}đ
        
        //- Section-2
        .section-2
            .inner-head
                h2.inner-title Biểu đồ doanh thu
                .inner-filler
                    input(type="month" name="")
            .inner-chart
                canvas(id="revenue-chart")
        
        //- Section-3
        .section-3
            h2.inner-title Đơn hàng mới
            .table-1
                table
                    thead
                        tr
                            th Mã
                            th Thông tin khách
                            th Danh sách tour
                            th Thanh toán
                            th Trạng thái
                            th.inner-text-right Ngày đặt
                    tbody
                        tr
                            td.inner-code OD00001
                            td
                                div Họ tên: Lê Văn A
                                div SĐT: 0123456789
                                div Ghi chú: Test...
                            td
                                .inner-list
                                    .inner-item
                                        .inner-image
                                            img(src="/admin/assets/images/Tour-Icon.jpg")
                                        .inner-content
                                            .inner-name Tour Hạ Long
                                            .inner-quantity Người lớn: 3 x 1.500.000đ
                                            .inner-quantity Trẻ em: 2 x 1.300.000đ
                                            .inner-quantity Em bé: 2 x 1.000.000đ
                                    .inner-item
                                        .inner-image
                                            img(src="/admin/assets/images/Tour-Icon.jpg")
                                        .inner-content
                                            .inner-name Tour Hạ Long
                                            .inner-quantity Người lớn: 3 x 1.500.000đ
                                            .inner-quantity Trẻ em: 2 x 1.300.000đ
                                            .inner-quantity Em bé: 2 x 1.000.000đ
                            td
                                div Tổng tiền: 10.000.000đ
                                div Giảm: 400.000đ
                                div Mã giảm: TOURMUAHE2024
                                div Thanh toán: 9.600.000đ
                                div PTTT: Ví Momo
                                div TTTT: Đã thanh toán
                            td
                                .badge.badge-orange Khởi tạo
                            td.inner-text-right
                                div 16:20
                                div 01/01/2024