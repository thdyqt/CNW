extends ../layouts/default.pug

block main
    h1.box-title Nhóm quyền
    
    //- Section-5
    .section-5
        .inner-wrap
            .inner-check-status
                .inner-item
                    select
                        option(value="") -- Hành động --
                        option(value="") Hoạt động
                        option(value="") Dừng hoạt động
                        option(value="") Xóa
                .inner-item
                    button Áp dụng
            .inner-search
                i.fa-solid.fa-magnifying-glass
                input(type="text", placeholder="Tìm kiếm")
            .inner-button-create
                a(href=`/${pathAdmin}/setting/role/create`)  + Tạo mới

    //- Section-6
    .section-6
        .table-2
            table
                thead
                    tr
                        th.inner-center
                            input.inner-check(type="checkbox")
                        th Tên nhóm quyền
                        th Mô tả ngắn
                        th Hành động
                tbody
                    tr
                        td.inner-center
                            input.inner-check(type="checkbox")
                        td Quản trị viên
                        td Có đầy đủ các quyền
                        td
                            .badge.badge-green Hoạt động
                        td
                            .inner-buttons
                                button.inner-edit
                                    i.fa-regular.fa-pen-to-square
                                button.inner-delete
                                    i.fa-regular.fa-trash-can 
                    tr
                        td.inner-center
                            input.inner-check(type="checkbox")
                        td Quản lý tour
                        td Có đầy đủ quyền liên quan đến tour
                        td
                            .badge.badge-green Hoạt động
                        td
                            .inner-buttons
                                button.inner-edit
                                    i.fa-regular.fa-pen-to-square
                                button.inner-delete
                                    i.fa-regular.fa-trash-can 
                    tr
                        td.inner-center
                            input.inner-check(type="checkbox")
                        td Quản lý đơn hàng
                        td Có đầy đủ quyền liên quan đến đơn hàng
                        td
                            .badge.badge-green Hoạt động
                        td
                            .inner-buttons
                                button.inner-edit
                                    i.fa-regular.fa-pen-to-square
                                button.inner-delete
                                    i.fa-regular.fa-trash-can 
    
    //- Section-7
    .section-7
        span.inner-label Hiển thị 1 - 9 của 78
        select.inner-pagination
            option Trang 1
            option Trang 2
            option Trang 3
            