extends ../layouts/default.pug

block main
    h1.box-title Nhóm quyền
    
    //- Section-5
    .section-5
        .inner-wrap
            .inner-check-status(change-multi data-api=`/${pathAdmin}/setting/role/change-multi`)
                .inner-item
                    select
                        option(value="") -- Hành động --
                        option(value="delete") Xóa
                .inner-item
                    button Áp dụng
            .inner-search
                i.fa-solid.fa-magnifying-glass
                input(type="text", placeholder="Tìm kiếm" search)
            .inner-button-create
                a(href=`/${pathAdmin}/setting/role/create`)  + Tạo mới

    //- Section-6
    .section-6
        .table-2
            table
                thead
                    tr
                        th.inner-center
                            input.inner-check(type="checkbox" check-all)
                        th Tên nhóm quyền
                        th Mô tả ngắn
                        th Hành động
                tbody 
                    each item in roleList
                        tr
                            td.inner-center
                                input.inner-check(type="checkbox" check-item=item.id)
                            td #{item.name}
                            td #{item.description}
                            td
                                .inner-buttons
                                    a.inner-edit(href=`/${pathAdmin}/setting/role/edit/${item.id}`)
                                        i.fa-regular.fa-pen-to-square
                                    button.inner-delete(button-delete data-api=`/${pathAdmin}/setting/role/delete/${item.id}`)
                                        i.fa-regular.fa-trash-can 
    
    //- Section-7
    .section-7
        if roleList.length > 0
            span.inner-label Hiển thị #{pagination.skip + 1} - #{pagination.skip + roleList.length} của #{pagination.totalRecord}
            select.inner-pagination(pagination)
                - for (let i = 1; i <= pagination.totalPage; i++)
                    option(value=i) Trang #{i}
        else 
            span.inner-label Không có dữ liệu để hiển thị
            