extends ../layouts/default.pug

block main
    if(account.permissions.includes("tour-trash"))
        h1.box-title Thùng rác tour
        
        //- Section-5
        .section-5
            .inner-wrap
                .inner-check-status(change-multi data-api=`/${pathAdmin}/tour/trash/change-multi`)
                    .inner-item
                        select
                            option(value="") -- Hành động --
                            option(value="undo") Khôi phục
                            option(value="delete-destroy") Xóa vĩnh viễn
                    .inner-item
                        button Áp dụng
                .inner-search
                    i.fa-solid.fa-magnifying-glass
                    input(type="text", placeholder="Tìm kiếm" search)
        
        //- Section-6
        .section-6
            .table-2
                table
                    thead
                        tr
                            th.inner-center
                                input.inner-check(type="checkbox" check-all)
                            th Tên tour
                            th.inner-center Ảnh đại diện
                            th Giá
                            th Còn lại
                            th.inner-center Vị trí
                            th.inner-center Trạng thái
                            th Tạo bởi
                            th Xóa bởi
                            th Hành động
                    tbody
                        each item in tourList
                            tr
                                td.inner-center
                                    input.inner-check(type="checkbox" check-item=item.id)
                                td #{item.name}
                                td.inner-center
                                    img(src=item.avatar)
                                td
                                    div NL: #{item.priceNewAdult > 0 ? item.priceNewAdult.toLocaleString("vi-VN") : item.priceAdult.toLocaleString("vi-VN")}đ
                                    div TE: #{item.priceNewChildren > 0 ? item.priceNewChildren.toLocaleString("vi-VN") : item.priceChildren.toLocaleString("vi-VN")}đ
                                    div EB: #{item.priceNewBaby > 0 ? item.priceNewBaby.toLocaleString("vi-VN") : item.priceBaby.toLocaleString("vi-VN")}đ
                                td
                                    div NL: #{item.stockAdult}
                                    div TE: #{item.stockChildren}
                                    div EB: #{item.stockBaby}
                                td.inner-center #{item.position}
                                td.inner-center
                                    case item.status
                                        when "active"
                                            .badge.badge-green Hoạt động
                                        when "inactive"
                                            .badge.badge-red Tạm dừng
                                td
                                    div #{item.createdByFullName}
                                    .inner-time #{item.createdAtFormatted}
                                td
                                    div #{item.deletedByFullName}
                                    .inner-time #{item.deletedAtFormatted}
                                td
                                    .inner-buttons
                                        button.inner-undo(button-undo data-api=`/${pathAdmin}/tour/undo/${item.id}`)
                                            i.fa-solid.fa-arrow-rotate-left
                                        button.inner-delete(button-delete-destroy data-api=`/${pathAdmin}/tour/delete-destroy/${item.id}`)
                                            i.fa-regular.fa-trash-can 
        
        //- Section-7
        .section-7
            if tourList.length > 0
                span.inner-label Hiển thị #{pagination.skip + 1} - #{pagination.skip + tourList.length} của #{pagination.totalRecord}
                select.inner-pagination(pagination)
                    - for (let i = 1; i <= pagination.totalPage; i++)
                        option(value=i) Trang #{i}
            else 
                span.inner-label Không có dữ liệu để hiển thị   