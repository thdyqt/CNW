extends ../layouts/default.pug

block main
    h1.box-title Thùng rác tour
    
    //- Section-5
    .section-5
        .inner-wrap
            .inner-check-status
                .inner-item
                    select
                        option(value="") -- Hành động --
                        option(value="") Khôi phục
                        option(value="") Xóa vĩnh viễn
                .inner-item
                    button Áp dụng
            .inner-search
                i.fa-solid.fa-magnifying-glass
                input(type="text", placeholder="Tìm kiếm")
    
    //- Section-6
    .section-6
        .table-2
            table
                thead
                    tr
                        th.inner-center
                            input.inner-check(type="checkbox")
                        th Tên tour
                        th.inner-center Ảnh đại diện
                        th Giá
                        th Còn lại
                        th.inner-center Vị trí
                        th.inner-center Trạng thái
                        th Tạo bởi
                        th Xóa bởi
                        th Hành động
                tbody
                    tr
                        td.inner-center
                            input.inner-check(type="checkbox")
                        td Tour Hạ Long
                        td.inner-center
                            img(src="/admin/assets/images/Tour-Icon.jpg")
                        td
                            div NL: 1.900.000đ
                            div TE: 1.600.000đ
                            div EB: 1.000.000đ
                        td
                            div NL: 30
                            div TE: 20
                            div EB: 10
                        td.inner-center 1
                        td.inner-center
                            .badge.badge-green Hoạt động
                        td
                            div Lê Văn A
                            .inner-time 16:30 - 20/10/2024
                        td
                            div Lê Văn A
                            .inner-time 16:30 - 20/10/2024  
                        td
                            .inner-buttons
                                button.inner-edit
                                    i.fa-solid.fa-arrow-rotate-left
                                button.inner-delete
                                    i.fa-regular.fa-trash-can 
    
    //- Section-7
    .section-7
        span.inner-label Hiển thị 1 - 9 của 78
        select.inner-pagination
            option Trang 1
            option Trang 2
            option Trang 3