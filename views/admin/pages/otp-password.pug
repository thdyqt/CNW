extends ../layouts/account.pug

block main
    .form-account
        h2.inner-title Nhập mã OTP
        p.inner-desc Vui lòng nhập mã OTP để tiếp tục
        form.inner-form#otp-form
            .inner-group
                label.inner-label(for="otp-input") Mã OTP
                input.inner-control(type="number", id="otp-input", name="otp", placeholder="Ví dụ: 123456")
            button.inner-button Xác thực
        .inner-more
            span Bạn đã nhớ mật khẩu?
            a(href=`/${pathAdmin}/account/login`) Đăng nhập

