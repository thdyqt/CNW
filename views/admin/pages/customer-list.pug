extends ../layouts/default.pug

block title
    title Quản lý danh mục

block main
    h1.box-title Quản lý danh mục

    //- Section-4
    .section-4
        .inner-wrap
            .inner-item.inner-label
                i.fa-solid.fa-filter 
                | Bộ lọc
            .inner-item
                select
                    option(value="") Trạng thái
                    option(value="") Hoạt động
                    option(value="") Tạm dừng
            .inner-item
                select
                    option(value="") Người tạo
                    option(value="") Lê Văn A
                    option(value="") Lê Văn B
            .inner-item
                input(type="date")
                span -
                input(type="date")
            .inner-item.inner-reset
                i.fa-solid.fa-rotate-left 
                | Xóa bộ lọc
    
    //- Section-5
    .section-5
        .inner-wrap
            .inner-check-status
                .inner-item
                    select
                        option(value="") -- Hành động --
                        option(value="") Hoạt động
                        option(value="") Dừng hoạt động
                        option(value="") Xóa
                .inner-item
                    button Áp dụng
            .inner-search
                i.fa-solid.fa-magnifying-glass
                input(type="text", placeholder="Tìm kiếm")
            .inner-button-create
                button + Tạo mới

    //- Section-6
    .section-6
        .table-2
            table
                thead
                    tr
                        th.inner-center
                            input.inner-check(type="checkbox")
                        th Tên danh mục
                        th.inner-center Ảnh đại diện
                        th.inner-center Vị trí
                        th.inner-center Trạng thái
                        th Tạo bởi
                        th Cập nhật bởi
                        th Hành động
                tbody
                    tr
                        td.inner-center
                            input.inner-check(type="checkbox")
                        td Danh mục 1
                        td.inner-center
                            img(src="assets/images/Tour-Icon.jpg")
                        td.inner-center 1
                        td.inner-center
                            .badge.badge-green Hoạt động
                        td
                            div Lê Văn A
                            .inner-time 16:30 - 20/10/2024
                        td
                            div Lê Văn A
                            .inner-time 16:30 - 20/10/2024  
                        td
                            .inner-buttons
                                button.inner-edit
                                    i.fa-regular.fa-pen-to-square
                                button.inner-delete
                                    i.fa-regular.fa-trash-can 
                    tr
                        td.inner-center
                            input.inner-check(type="checkbox")
                        td Danh mục 2
                        td.inner-center
                            img(src="assets/images/Tour-Icon.jpg")
                        td.inner-center 2
                        td.inner-center
                            .badge.badge-red Tạm dừng
                        td
                            div Lê Văn A
                            .inner-time 16:30 - 20/10/2024
                        td
                            div Lê Văn A
                            .inner-time 16:30 - 20/10/2024  
                        td
                            .inner-buttons
                                button.inner-edit
                                    i.fa-regular.fa-pen-to-square
                                button.inner-delete
    
                                    i.fa-regular.fa-trash-can  
    
    //- Section-7
    .section-7
        span.inner-label Hiển thị 1 - 9 của 78
        select.inner-pagination
            option Trang 1
            option Trang 2
            option Trang 3
            