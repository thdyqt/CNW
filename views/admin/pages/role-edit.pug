extends ../layouts/default.pug


block main
    h1.box-title Chỉnh sửa nhóm quyền

    .section-8
        form#role-edit-form
            .inner-group(style="display: none;")
                input(type="text", id="id", name="id", value=currentRole.id)
            .inner-group
                label.inner-label(for="name") Tên nhóm quyền
                input(type="text", id="name", name="name", value=currentRole.name)
            .inner-group
                label.inner-label(for="description") Mô tả ngắn
                input(type="text", id="description", name="description", value=currentRole.description)
            .inner-group
                label.inner-label Phân quyền
                    .inner-checkbox-list
                        each item in permissionList
                            .inner-checkbox-item
                                input(type="checkbox", id=item.value, name="permissions" value=item.value, checked=currentRole.permissions.includes(item.value))
                                label(for=item.value) #{item.label}
                        
            .inner-button.inner-two-col
                button Cập nhật
        .inner-back
            a(href=`/${pathAdmin}/setting/role/list`) Quay lại danh sách