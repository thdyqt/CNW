extends ../layouts/default.pug

block main
    h1.box-title Quản lý người dùng

    //- Section-4
    .section-4
        .inner-wrap
            .inner-item.inner-label
                i.fa-solid.fa-filter 
                | Bộ lọc
            .inner-item
                select
                    option(value="") Trạng thái
                    option(value="") Hoạt động
                    option(value="") Tạm dừng
            .inner-item
                input(type="date")
                span -
                input(type="date")
            .inner-item.inner-reset
                i.fa-solid.fa-rotate-left 
                | Xóa bộ lọc
    
    //- Section-5
    .section-5
        .inner-wrap
            .inner-check-status
                .inner-item
                    select
                        option(value="") -- Hành động --
                        option(value="") Hoạt động
                        option(value="") Dừng hoạt động
                        option(value="") Xóa
                .inner-item
                    button Áp dụng
            .inner-search
                i.fa-solid.fa-magnifying-glass
                input(type="text", placeholder="Tìm kiếm")

    //- Section-6
    .section-6
        .table-2
            table
                thead
                    tr
                        th.inner-center
                            input.inner-check(type="checkbox")
                        th Họ tên
                        th.inner-center Ảnh đại diện
                        th Email
                        th Số điện thoại
                        th Địa chỉ
                        th Trạng thái
                        th Hành động
                tbody
                    tr
                        td.inner-center
                            input.inner-check(type="checkbox")
                        td Lê Văn A
                        td.inner-center
                            img(src="/admin/assets/images/AvatarIcon2.jpg")
                        td levana@gmail.com
                        td 01234567890
                        td Số 123, đường ABC,...
                        td
                            .badge.badge-green Hoạt động
                        td
                            .inner-buttons
                                button.inner-edit
                                    i.fa-regular.fa-pen-to-square
                                button.inner-delete
                                    i.fa-regular.fa-trash-can 
                    tr
                        td.inner-center
                            input.inner-check(type="checkbox")
                        td Lê Văn B
                        td.inner-center
                            img(src="/admin/assets/images/AvatarIcon2.jpg")
                        td levanb@gmail.com
                        td 01234567891
                        td Số 124, đường ABC,...
                        td
                            .badge.badge-red Tạm dừng
                        td
                            .inner-buttons
                                button.inner-edit
                                    i.fa-regular.fa-pen-to-square
                                button.inner-delete
                                    i.fa-regular.fa-trash-can 
    
    //- Section-7
    .section-7
        span.inner-label Hiển thị 1 - 9 của 78
        select.inner-pagination
            option Trang 1
            option Trang 2
            option Trang 3
            