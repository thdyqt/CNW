extends ../layouts/default.pug

block main
    h1.box-title Thông tin website

    .section-8
        form#website-form
            .inner-group
                label.inner-label(for="websiteName") Tên website
                input(type="text", id="websiteName", name="websiteName", value=settingWebsiteInfo.websiteName)
            .inner-group
                label.inner-label(for="phone") Số điện thoại
                input(type="number", id="phone", name="phone", value=settingWebsiteInfo.phone)
            .inner-group
                label.inner-label(for="email") Email
                input(type="email", id="email", name="email", value=settingWebsiteInfo.email)
            .inner-group
                label.inner-label(for="address") Địa chỉ
                input(type="text", id="address", name="address", value=settingWebsiteInfo.address)
            .inner-group
                label.inner-label(for="logo") Logo
                .inner-input-image(image-default=settingWebsiteInfo.logo)
                    input(type="file", id="logo", name="logo", accept="image/*" filepond-image) 
            .inner-group
                label.inner-label(for="favicon") Favicon
                .inner-input-image(image-default=settingWebsiteInfo.favicon)
                    input(type="file", id="favicon", name="favicon", accept="image/*" filepond-image)
            .inner-button.inner-two-col
                button Cập nhật
        .inner-back
            a(href=`/${pathAdmin}/setting/list`) Quay lại danh sách