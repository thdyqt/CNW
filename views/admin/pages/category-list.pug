extends ../layouts/default.pug

block main
    if(account.permissions.includes("category-view"))
        h1.box-title Quản lý danh mục

        //- Section-4
        .section-4
            .inner-wrap
                .inner-item.inner-label
                    i.fa-solid.fa-filter 
                    | Bộ lọc
                .inner-item
                    select(filter-status)
                        option(value="") Trạng thái
                        option(value="active") Hoạt động
                        option(value="inactive") Tạm dừng
                .inner-item
                    select(filter-created-by)
                        option(value="") Người tạo
                        each item in accountAdminList
                            option(value=item.id) #{item.fullName}
                .inner-item
                    input(type="date" filter-start-date)
                    span -
                    input(type="date" filter-end-date)
                .inner-item.inner-reset(filter-reset)
                    i.fa-solid.fa-rotate-left 
                    | Xóa bộ lọc
        
        //- Section-5
        .section-5
            .inner-wrap
                .inner-check-status(change-multi data-api=`/${pathAdmin}/category/change-multi`)
                    .inner-item
                        select
                            option(value="") -- Hành động --
                            if(account.permissions.includes("category-edit"))
                                option(value="active") Hoạt động
                                option(value="inactive") Tạm dừng
                            if(account.permissions.includes("category-delete"))
                                option(value="delete") Xóa
                    .inner-item
                        button Áp dụng
                .inner-search
                    i.fa-solid.fa-magnifying-glass
                    input(type="text", placeholder="Tìm kiếm" search)
                if(account.permissions.includes("category-create"))
                    .inner-button-create
                        a(href=`/${pathAdmin}/category/create`) + Tạo mới

        //- Section-6
        .section-6
            h2.inner-title Đơn hàng mới
            .table-2
                table
                    thead
                        tr
                            th.inner-center
                                input.inner-check(type="checkbox" check-all)
                            th Tên danh mục
                            th.inner-center Ảnh đại diện
                            th.inner-center Vị trí
                            th.inner-center Trạng thái
                            th Tạo bởi
                            th Cập nhật bởi
                            th Hành động
                    tbody
                        each item in categoryList
                            tr
                                td.inner-center
                                    input.inner-check(type="checkbox" check-item=item.id)
                                td #{item.name}
                                td.inner-center
                                    img(src=item.avatar)
                                td.inner-center #{item.position}
                                td.inner-center
                                    case item.status
                                        when "active"
                                            .badge.badge-green Hoạt động
                                        when "inactive"
                                            .badge.badge-red Tạm dừng
                                td
                                    div #{item.createdByFullName}
                                    .inner-time #{item.createdAtFormatted}
                                td
                                    div #{item.updatedByFullName}
                                    .inner-time #{item.updatedAtFormatted}
                                td
                                    .inner-buttons
                                        if(account.permissions.includes("category-edit"))
                                            a.inner-edit(href=`/${pathAdmin}/category/edit/${item.id}`)
                                                i.fa-regular.fa-pen-to-square
                                        if(account.permissions.includes("category-delete"))
                                            button.inner-delete(button-delete data-api=`/${pathAdmin}/category/delete/${item.id}`)
                                                i.fa-regular.fa-trash-can 
        
        //- Section-7
        .section-7
            if categoryList.length > 0
                span.inner-label Hiển thị #{pagination.skip + 1} - #{pagination.skip + categoryList.length} của #{pagination.totalRecord}
                select.inner-pagination(pagination)
                    - for (let i = 1; i <= pagination.totalPage; i++)
                        option(value=i) Trang #{i}
            else 
                span.inner-label Không có dữ liệu để hiển thị
            