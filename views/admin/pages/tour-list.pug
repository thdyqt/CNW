extends ../layouts/default.pug

block main
    h1.box-title Quản lý tour

    //- Section-4
    .section-4
        .inner-wrap
            .inner-item.inner-label
                i.fa-solid.fa-filter 
                | Bộ lọc
            .inner-item
                select
                    option(value="") Trạng thái
                    option(value="") Hoạt động
                    option(value="") Tạm dừng
            .inner-item
                select
                    option(value="") Người tạo
                    option(value="") Lê Văn A
                    option(value="") Lê Văn B
            .inner-item
                input(type="date")
                span -
                input(type="date")
            .inner-item
                select
                    option(value="") Danh mục
                    option(value="") Danh mục 1
                    option(value="") Danh mục 2
            .inner-item
                select
                    option(value="") Mức giá
                    option(value="") Dưới 2tr
                    option(value="") 2tr đến 4tr
                    option(value="") 4tr đến 8tr
                    option(value="") Trên 8tr
            .inner-item.inner-reset
                i.fa-solid.fa-rotate-left 
                | Xóa bộ lọc
    
    //- Section-5
    .section-5
        .inner-wrap
            .inner-check-status
                .inner-item
                    select
                        option(value="") -- Hành động --
                        option(value="") Hoạt động
                        option(value="") Dừng hoạt động
                        option(value="") Xóa
                .inner-item
                    button Áp dụng
            .inner-search
                i.fa-solid.fa-magnifying-glass
                input(type="text", placeholder="Tìm kiếm")
            .inner-button-create
                a(href=`/${pathAdmin}/tour/create`)  + Tạo mới
            .inner-button-delete
                a(href=`/${pathAdmin}/tour/trash`)  Thùng rác
    
    //- Section-6
    .section-6
        .table-2
            table
                thead
                    tr
                        th.inner-center
                            input.inner-check(type="checkbox")
                        th Tên tour
                        th.inner-center Ảnh đại diện
                        th Giá
                        th Còn lại
                        th.inner-center Vị trí
                        th.inner-center Trạng thái
                        th Tạo bởi
                        th Cập nhật bởi
                        th Hành động
                tbody
                    tr
                        td.inner-center
                            input.inner-check(type="checkbox")
                        td Tour Hạ Long
                        td.inner-center
                            img(src="/admin/assets/images/Tour-Icon.jpg")
                        td
                            div NL: 1.900.000đ
                            div TE: 1.600.000đ
                            div EB: 1.000.000đ
                        td
                            div NL: 30
                            div TE: 20
                            div EB: 10
                        td.inner-center 1
                        td.inner-center
                            .badge.badge-green Hoạt động
                        td
                            div Lê Văn A
                            .inner-time 16:30 - 20/10/2024
                        td
                            div Lê Văn A
                            .inner-time 16:30 - 20/10/2024  
                        td
                            .inner-buttons
                                button.inner-edit
                                    i.fa-regular.fa-pen-to-square
                                button.inner-delete
                                    i.fa-regular.fa-trash-can 
    
    //- Section-7
    .section-7
        span.inner-label Hiển thị 1 - 9 của 78
        select.inner-pagination
            option Trang 1
            option Trang 2
            option Trang 3