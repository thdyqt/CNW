extends ../layouts/default.pug

block main
    h1.box-title Đơn hàng: OD000001

    .section-8
        form#order-modify-form
            .inner-group
                label.inner-label(for="name") Tên khách hàng
                input(type="text", id="name", name="name")
            .inner-group
                label.inner-label(for="phone") Số điện thoại
                input(type="number", id="phone", name="phone")
            .inner-group.inner-two-col
                label.inner-label(for="note") Ghi chú
                textarea(id="note", name="note")
            .inner-group
                label.inner-label(for="payment-method") Phương thức thanh toán
                select(id="payment-method", name="paymentMethod")
                    option(value="") Ví Momo
                    option(value="") VNPay
                    option(value="") ZaloPay
            .inner-group
                label.inner-label(for="payment-status") Trạng thái thanh toán
                select(id="payment-status", name="paymentStatus")
                    option(value="") Chưa thanh toán
                    option(value="") Đã thanh toán
            .inner-group
                label.inner-label(for="time") Ngày đặt
                input(type="text", id="time", name="time" readonly)
            .inner-group
                label.inner-label(for="status") Trạng thái
                select(id="status", name="status")
                    option(value="") Hoạt động
                    option(value="") Tạm dừng
            .inner-group
                label.inner-label Danh sách tour
                .inner-list
                    .inner-item
                        .inner-image
                            img(src="/admin/assets/images/Tour-Icon.jpg")
                        .inner-content
                            .inner-order-name Tour Hạ Long
                            .inner-order-text Người lớn: 3 x 1.500.000đ
                            .inner-order-text Trẻ em: 2 x 1.300.000đ
                            .inner-order-text Em bé: 2 x 1.000.000đ
                            .inner-order-text Ngày khởi hành: 20/10/2024
                            .inner-order-text Khởi hành tại: Hà Nội

                    .inner-item
                        .inner-image
                            img(src="/admin/assets/images/Tour-Icon.jpg")
                        .inner-content
                            .inner-order-name Tour Hạ Long
                            .inner-order-text Người lớn: 3 x 1.500.000đ
                            .inner-order-text Trẻ em: 2 x 1.300.000đ
                            .inner-order-text Em bé: 2 x 1.000.000đ
                            .inner-order-text Ngày khởi hành: 20/10/2024
                            .inner-order-text Khởi hành tại: Hà Nội
            .inner-group
                label.inner-label Thanh toán
                .inner-order-total
                    div Tổng tiền: 10.000.000đ
                    div Giảm: 400.000đ
                    div Mã giảm: TOURMUAHE2024
                    div Thanh toán: <span class="inner-order-price">9.600.000đ</span>
            .inner-button.inner-two-col
                button Cập nhật
        .inner-back
            a(href=`/${pathAdmin}/order/list`) Quay lại danh sách