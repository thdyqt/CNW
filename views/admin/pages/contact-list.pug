extends ../layouts/default.pug

block main
    h1.box-title Thông tin liên hệ

    //- Section-4
    .section-4
        .inner-wrap
            .inner-item.inner-label
                i.fa-solid.fa-filter 
                | Bộ lọc
            .inner-item
                input(type="date" filter-start-date)
                span -
                input(type="date" filter-end-date)
            .inner-item.inner-reset(filter-reset)
                i.fa-solid.fa-rotate-left 
                | Xóa bộ lọc
    
    //- Section-5
    .section-5
        .inner-wrap
            .inner-check-status(change-multi data-api=`/${pathAdmin}/contact/change-multi`)
                .inner-item
                    select
                        option(value="") -- Hành động --
                        option(value="delete") Xóa
                .inner-item
                    button Áp dụng
            .inner-search
                i.fa-solid.fa-magnifying-glass
                input(type="text", placeholder="Tìm kiếm" search)

    //- Section-6
    .section-6
        .table-2
            table
                thead
                    tr
                        th.inner-center
                            input.inner-check(type="checkbox")
                        th Email
                        th Ngày tạo
                        th.inner-center Hành động
                tbody
                    each item in contactList
                        tr
                            td.inner-center
                                input.inner-check(type="checkbox")
                            td #{item.email}
                            td #{item.createdAtFormatted}
                            td.inner-center
                                .inner-buttons
                                    button.inner-delete(button-delete data-api=`/${pathAdmin}/contact/delete/${item.id}`)
                                        i.fa-regular.fa-trash-can 
    
    //- Section-7
    .section-7
        if contactList.length > 0
            span.inner-label Hiển thị #{pagination.skip + 1} - #{pagination.skip + contactList.length} của #{pagination.totalRecord}
            select.inner-pagination(pagination)
                - for (let i = 1; i <= pagination.totalPage; i++)
                    option(value=i) Trang #{i}
        else 
            span.inner-label Không có dữ liệu để hiển thị
            