extends ../layouts/default.pug

block main
    h1.box-title Thông tin liên hệ

    //- Section-4
    .section-4
        .inner-wrap
            .inner-item.inner-label
                i.fa-solid.fa-filter 
                | Bộ lọc
            .inner-item
                input(type="date")
                span -
                input(type="date")
            .inner-item.inner-reset
                i.fa-solid.fa-rotate-left 
                | Xóa bộ lọc
    
    //- Section-5
    .section-5
        .inner-wrap
            .inner-check-status
                .inner-item
                    select
                        option(value="") -- Hành động --
                        option(value="") Hoạt động
                        option(value="") Dừng hoạt động
                        option(value="") Xóa
                .inner-item
                    button Áp dụng
            .inner-search
                i.fa-solid.fa-magnifying-glass
                input(type="text", placeholder="Tìm kiếm")

    //- Section-6
    .section-6
        .table-2
            table
                thead
                    tr
                        th.inner-center
                            input.inner-check(type="checkbox")
                        th Email
                        th Ngày tạo
                        th.inner-center Hành động
                tbody
                    tr
                        td.inner-center
                            input.inner-check(type="checkbox")
                        td levana@gmail.com
                        td 16:40 - 12/12/2024
                        td.inner-center
                            .inner-buttons
                                button.inner-delete
                                    i.fa-regular.fa-trash-can 
    
    //- Section-7
    .section-7
        span.inner-label Hiển thị 1 - 9 của 78
        select.inner-pagination
            option Trang 1
            option Trang 2
            option Trang 3
            