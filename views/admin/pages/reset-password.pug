extends ../layouts/account.pug

block main
    .form-account
        h2.inner-title Đổi mật khẩu
        p.inner-desc Vui lòng nhập mật khẩu để tiếp tục
        form.inner-form#change-password-form
            .inner-group
                label.inner-label(for="new-password-input") Mật khẩu mới
                input.inner-control(type="password", id="new-password-input", name="newPassword")
            .inner-group
                label.inner-label(for="confirm-password-input") Xác nhận mật khẩu
                input.inner-control(type="password", id="confirm-password-input", name="confirmPassword")
            button.inner-button Thay đổi
        .inner-more
            span Bạn đã nhớ mật khẩu
            a(href=`/${pathAdmin}/account/login`) Đăng nhập