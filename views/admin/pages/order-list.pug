extends ../layouts/default.pug

block main
    h1.box-title Quản lý đơn hàng

    //- Section-4
    .section-4
        .inner-wrap
            .inner-item.inner-label
                i.fa-solid.fa-filter 
                | Bộ lọc
            .inner-item
                select
                    option(value="") Trạng thái
                    option(value="") Hoạt động
                    option(value="") Tạm dừng
            .inner-item
                input(type="date")
                span -
                input(type="date")
            .inner-item
                select
                    option(value="") Phương thức thanh toán
                    option(value="") Ví Momo
                    option(value="") VNPay
                    option(value="") ZaloPay
            .inner-item
                select
                    option(value="") Trạng thái thanh toán
                    option(value="") Đã thanh toán
                    option(value="") Chưa thanh toán
            .inner-item.inner-reset
                i.fa-solid.fa-rotate-left 
                | Xóa bộ lọc
    
    //- Section-5
    .section-5
        .inner-wrap
            .inner-search
                i.fa-solid.fa-magnifying-glass
                input(type="text", placeholder="Tìm kiếm")
    
    //- Section-6
    .section-6
        .table-2
            table
                thead
                    tr
                        th Mã
                        th Thông tin khách
                        th Danh sách tour
                        th Thanh toán
                        th Trạng thái
                        th.inner-center Ngày đặt
                        th Hành động
                tbody
                    tr
                        td.inner-code OD00001
                        td
                            div Họ tên: Lê Văn A
                            div SĐT: 0123456789
                            div Ghi chú: Test...
                        td
                            .inner-list
                                .inner-item
                                    .inner-image
                                        img(src="/admin/assets/images/Tour-Icon.jpg")
                                    .inner-content
                                        .inner-name Tour Hạ Long
                                        .inner-quantity Người lớn: 3 x 1.500.000đ
                                        .inner-quantity Trẻ em: 2 x 1.300.000đ
                                        .inner-quantity Em bé: 2 x 1.000.000đ
                                .inner-item
                                    .inner-image
                                        img(src="/admin/assets/images/Tour-Icon.jpg")
                                    .inner-content
                                        .inner-name Tour Hạ Long
                                        .inner-quantity Người lớn: 3 x 1.500.000đ
                                        .inner-quantity Trẻ em: 2 x 1.300.000đ
                                        .inner-quantity Em bé: 2 x 1.000.000đ
                        td
                            div Tổng tiền: 10.000.000đ
                            div Giảm: 400.000đ
                            div Mã giảm: TOURMUAHE2024
                            div Thanh toán: 9.600.000đ
                            div PTTT: Ví Momo
                            div TTTT: Đã thanh toán
                        td
                            .badge.badge-orange Khởi tạo
                        td.inner-center
                            div 16:20
                            div 01/01/2024
                        td
                            .inner-buttons
                                button.inner-edit
                                    i.fa-regular.fa-pen-to-square
                                button.inner-delete
                                    i.fa-regular.fa-trash-can 
    
    //- Section-7
    .section-7
        span.inner-label Hiển thị 1 - 9 của 78
        select.inner-pagination
            option Trang 1
            option Trang 2
            option Trang 3