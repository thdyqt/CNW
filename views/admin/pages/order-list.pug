extends ../layouts/default.pug

block main
    h1.box-title Quản lý đơn hàng

    //- Section-4
    .section-4
        .inner-wrap
            .inner-item.inner-label
                i.fa-solid.fa-filter 
                | Bộ lọc
            .inner-item
                select
                    option(value="") Trạng thái
                    option(value="") Hoạt động
                    option(value="") Tạm dừng
            .inner-item
                input(type="date")
                span -
                input(type="date")
            .inner-item
                select
                    option(value="") Phương thức thanh toán
                    option(value="") Ví Momo
                    option(value="") VNPay
                    option(value="") ZaloPay
            .inner-item
                select
                    option(value="") Trạng thái thanh toán
                    option(value="") Đã thanh toán
                    option(value="") Chưa thanh toán
            .inner-item.inner-reset
                i.fa-solid.fa-rotate-left 
                | Xóa bộ lọc
    
    //- Section-5
    .section-5
        .inner-wrap
            .inner-search
                i.fa-solid.fa-magnifying-glass
                input(type="text", placeholder="Tìm kiếm")
    
    //- Section-6
    .section-6
        .table-2
            table
                thead
                    tr
                        th Mã
                        th Thông tin khách
                        th Danh sách tour
                        th Thanh toán
                        th.inner-center Trạng thái
                        th.inner-center Ngày đặt
                        th Hành động
                tbody
                    each orderDetail in orderList
                        tr
                            td.inner-code #{orderDetail.code}
                            td
                                div Họ tên: #{orderDetail.fullName}
                                div SĐT: #{orderDetail.phone}
                                div Ghi chú: #{orderDetail.note}
                            td
                                .inner-list
                                    each item in orderDetail.items
                                        .inner-item
                                            .inner-image
                                                img(src=item.avatar, alt=item.name)
                                            .inner-content
                                                .inner-name #{item.name}
                                                if(item.quantityAdult > 0)
                                                    .inner-quantity Người lớn: #{item.quantityAdult} x #{item.priceNewAdult.toLocaleString("vi-VN")}đ
                                                if(item.quantityChildren > 0)
                                                    .inner-quantity Trẻ em: #{item.quantityChildren} x #{item.priceNewChildren.toLocaleString("vi-VN")}đ
                                                if(item.quantityBaby > 0)
                                                    .inner-quantity Em bé: #{item.quantityBaby} x #{item.priceNewBaby.toLocaleString("vi-VN")}đ

                            td
                                div Tổng tiền: #{orderDetail.subTotal.toLocaleString("vi-VN")}đ
                                div Giảm: 0đ
                                div Mã giảm: 
                                div Thanh toán: #{orderDetail.total.toLocaleString("vi-VN")}đ
                                div PTTT: #{orderDetail.paymentMethodName}
                                div TTTT: #{orderDetail.paymentStatusName}
                            td.inner-center
                                case orderDetail.status
                                    when "done"
                                        .badge.badge-green Hoàn thành
                                    when "cancel"
                                        .badge.badge-red Hủy
                                    when "initial"
                                        .badge.badge-orange Khởi tạo
                            td.inner-center
                                div #{orderDetail.createdAtFormattedName}
                                div #{orderDetail.createdAtFormattedDate}
                            td
                                .inner-buttons
                                    a.inner-edit(href=`/${pathAdmin}/order/edit/${orderDetail.id}`)
                                        i.fa-regular.fa-pen-to-square
                                    button.inner-delete(button-delete data-api=`/${pathAdmin}/order/delete/${orderDetail.id}`)
                                        i.fa-regular.fa-trash-can 

    //- Section-7
    .section-7
        span.inner-label Hiển thị 1 - 9 của 78
        select.inner-pagination
            option Trang 1
            option Trang 2
            option Trang 3